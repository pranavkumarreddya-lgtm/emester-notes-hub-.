# Semester Notes Hub - Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
#
# IMPORTANT SECURITY NOTICE:
# NEVER expose the SUPABASE_SERVICE_ROLE_KEY in frontend code or .env.local!
# Use only your Supabase URL and the public anon/publishable key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
